{
  "version": "1.0",
  "last_updated": "2024-01-15",
  "description": "Comprehensive training data for Expedia.com AI agent interactions",
  
  "common_destinations": [
    "New York, NY (JFK)",
    "Los Angeles, CA (LAX)",
    "Chicago, IL (ORD)",
    "Miami, FL (MIA)",
    "Las Vegas, NV (LAS)",
    "San Francisco, CA (SFO)",
    "Orlando, FL (MCO)",
    "Boston, MA (BOS)",
    "Seattle, WA (SEA)",
    "Denver, CO (DEN)",
    "Atlanta, GA (ATL)",
    "Phoenix, AZ (PHX)",
    "Dallas, TX (DFW)",
    "Houston, TX (IAH)",
    "Philadelphia, PA (PHL)",
    "Detroit, MI (DTW)",
    "Minneapolis, MN (MSP)",
    "Charlotte, NC (CLT)",
    "Tampa, FL (TPA)",
    "Portland, OR (PDX)"
  ],
  
  "international_destinations": [
    "London, UK (LHR)",
    "Paris, France (CDG)",
    "Tokyo, Japan (NRT)",
    "Rome, Italy (FCO)",
    "Barcelona, Spain (BCN)",
    "Amsterdam, Netherlands (AMS)",
    "Frankfurt, Germany (FRA)",
    "Sydney, Australia (SYD)",
    "Toronto, Canada (YYZ)",
    "Mexico City, Mexico (MEX)"
  ],
  
  "booking_patterns": {
    "flight": {
      "required_fields": ["origin", "destination", "departure_date"],
      "optional_fields": ["return_date", "travelers", "class"],
      "field_order": ["origin", "destination", "departure_date", "return_date", "travelers", "class"],
      "common_classes": ["Economy", "Premium Economy", "Business", "First"],
      "traveler_options": [1, 2, 3, 4, 5, 6]
    },
    "hotel": {
      "required_fields": ["destination", "checkin_date", "checkout_date"],
      "optional_fields": ["guests", "rooms"],
      "field_order": ["destination", "checkin_date", "checkout_date", "guests", "rooms"],
      "guest_options": [1, 2, 3, 4, 5, 6],
      "room_options": [1, 2, 3, 4]
    },
    "car": {
      "required_fields": ["pickup_location", "pickup_date", "dropoff_date"],
      "optional_fields": ["dropoff_location", "driver_age"],
      "field_order": ["pickup_location", "dropoff_location", "pickup_date", "dropoff_date", "driver_age"],
      "age_options": ["25-29", "30-64", "65+"]
    },
    "package": {
      "required_fields": ["origin", "destination", "departure_date", "return_date"],
      "optional_fields": ["travelers", "rooms"],
      "field_order": ["origin", "destination", "departure_date", "return_date", "travelers", "rooms"]
    }
  },
  
  "element_selectors": {
    "search_forms": {
      "flight": [
        "[data-testid='flight-search-form']",
        ".flight-search-form",
        "#flight-search",
        "form[action*='flight']"
      ],
      "hotel": [
        "[data-testid='hotel-search-form']",
        ".hotel-search-form",
        "#hotel-search",
        "form[action*='hotel']"
      ],
      "car": [
        "[data-testid='car-search-form']",
        ".car-search-form",
        "#car-search",
        "form[action*='car']"
      ]
    },
    "location_inputs": [
      "[data-testid='origin-input']",
      "[data-testid='destination-input']",
      "[placeholder*='From' i]",
      "[placeholder*='To' i]",
      "[placeholder*='Where' i]",
      "input[name*='origin']",
      "input[name*='destination']"
    ],
    "date_inputs": [
      "[data-testid*='date']",
      ".date-picker-input",
      "input[type='date']",
      "[placeholder*='date' i]"
    ],
    "search_buttons": [
      "[data-testid='search-button']",
      "button[type='submit']",
      ".search-btn",
      ".search-button"
    ]
  },
  
  "interaction_patterns": {
    "typing_speed": {
      "min_delay": 0.05,
      "max_delay": 0.15,
      "word_pause": 0.3
    },
    "mouse_movement": {
      "natural_curve": true,
      "random_offset": 5,
      "hover_time": 0.2
    },
    "form_filling": {
      "field_delay": 0.5,
      "validation_wait": 1.0,
      "autocomplete_wait": 1.5
    }
  },
  
  "test_scenarios": [
